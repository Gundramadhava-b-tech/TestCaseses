# AeroDiag OSA Diagnostic System - Environment Template
# Copy this file to .env and fill in real credentials for local development.

PORT=5000
DATABASE_URL=

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=osadaignosticsystem.firebaseapp.com
FIREBASE_PROJECT_ID=osadaignosticsystem
FIREBASE_STORAGE_BUCKET=osadaignosticsystem.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Backend & Diagnostics API
API_BASE_URL=https://api.aerodiag.example.com
API_TIMEOUT_MS=10000

# Application Settings
ENABLE_ANALYTICS=true
DEFAULT_LOCALE=en_US
